# Postgres (Vercel Postgres / Neon / any Postgres URL)
DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require

# Public site URL (used for canonical, OG, sitemap)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Secret for the one-time /api/seed endpoint
SEED_SECRET=change-me-to-something-random

# Salt used to hash visitor cookie + IP (any random string)
VISITOR_SALT=change-me-too
